# Subpath where the site is mounted. '' once it lives on the gym's own domain.
BASE_PATH=/testsite/caravelas
NEXT_PUBLIC_SITE_URL=https://nicolino.zip/testsite/caravelas
# false -> noindex,nofollow meta + X-Robots-Tag header
NEXT_PUBLIC_INDEXABLE=false
# fixture | sheets | db. Use db after connecting Neon.
CONTENT_SOURCE=fixture
REVALIDATE_SECONDS=300
# shared with the Apps Script "Publicar" button
REVALIDATE_SECRET=change-me
# Google Sheet (CONTENT_SOURCE=sheets). The sheet is shared as "anyone with the link: viewer".
# SHEETS_ID is the part of the sheet URL between /d/ and /edit.
SHEETS_ID=
# Google Cloud API key restricted to the Google Sheets API. Secret: never commit it.
SHEETS_API_KEY=
# Neon Postgres connection URL, provided by the Vercel Marketplace integration.
DATABASE_URL=

# Internal dashboard at /admin. Use only the scheme and host here; BASE_PATH is added automatically.
ADMIN_SITE_ORIGIN=https://nicolino.zip
# Google Cloud OAuth "Web application" credentials. Authorized redirect URI:
# https://nicolino.zip/testsite/caravelas/api/admin/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google email addresses allowed to edit. Empty list denies everyone.
ADMIN_EMAILS=
# 32 random bytes encoded as base64url; generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ADMIN_SESSION_SECRET=
